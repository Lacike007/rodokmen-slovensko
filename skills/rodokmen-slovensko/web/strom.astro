---
import Base from '../layouts/Base.astro';
import strom from '../generated/rodinny_strom.html?raw';
---
<Base title="Rodinný strom" full>
  <div style="padding:0 24px">
  <h1>Rodinný strom</h1>
  <p class="muted">Kto je s kým a kto je čie dieťa – od spoločných predkov po dnešok. Dopĺňa sa v súbore <code>data/rodina.py</code>.</p>
  <p class="muted strom-tip">Strom posúvate ťahaním myšou (alebo kolieskom so Shiftom do strán), zväčšujete tlačidlami pri každom strome.</p>
  <div id="strom" set:html={strom} />
  </div>
</Base>

<style is:global>
  #strom .ft-wrap{overflow:auto;max-height:80vh;cursor:grab;border:1px solid #e4ddd5;border-radius:8px;background:#fdfcfa;user-select:none}
  #strom .ft-wrap.tahanie{cursor:grabbing}
  #strom .ft{margin:0;padding:16px 24px}
  .strom-ovl{display:flex;gap:6px;align-items:center;margin:4px 0 6px;font:13px Arial,sans-serif}
  .strom-ovl button{border:1px solid #c9bcae;background:#fff;border-radius:6px;padding:3px 10px;cursor:pointer;font:inherit}
  .strom-ovl button:hover{background:#f3ede6}
  .strom-ovl span{color:#6b5e54;min-width:3.5em;text-align:center}
  .ft-zbal{display:block;margin:3px auto 0;border:1px solid #c9bcae;background:#fff;border-radius:10px;padding:0 6px;font:11px Arial,sans-serif;color:#6b5e54;cursor:pointer;line-height:16px}
  .ft-zbal:hover{background:#f3ede6}
  #strom li.zbalene > ul{display:none}
</style>

<script>
  for (const wrap of document.querySelectorAll<HTMLElement>('#strom .ft-wrap')) {
    const ft = wrap.querySelector<HTMLElement>('.ft');
    if (!ft) continue;
    let mierka = 1;
    const ovl = document.createElement('div');
    ovl.className = 'strom-ovl';
    ovl.innerHTML = '<button data-a="-">−</button><span>100 %</span><button data-a="+">+</button>' +
      '<button data-a="fit">Celý strom</button><button data-a="1">100 %</button>';
    wrap.before(ovl);
    const popis = ovl.querySelector('span')!;
    const nastav = (m: number) => {
      mierka = Math.min(2, Math.max(0.2, m));
      ft.style.zoom = String(mierka);
      popis.textContent = Math.round(mierka * 100) + ' %';
    };
    ovl.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).dataset.a;
      if (a === '+') nastav(mierka * 1.25);
      else if (a === '-') nastav(mierka / 1.25);
      else if (a === '1') nastav(1);
      else if (a === 'fit') { nastav(1); nastav((wrap.clientWidth - 8) / ft.scrollWidth); }
    });
    // rozbaľovanie a zbaľovanie vetiev (nápad z forkov jozefizso/mplisek rodokmen-skill)
    const pocet = (li: Element) => li.querySelectorAll(':scope ul .ft-p:not(.ft-empty)').length;
    const vetvy: HTMLElement[] = [];
    for (const couple of ft.querySelectorAll<HTMLElement>('.ft-couple')) {
      const li = couple.parentElement!;
      const ul = li.querySelector(':scope > ul');
      const n = ul ? pocet(li) : 0;
      if (!n) continue;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'ft-zbal';
      const popis = () => { b.textContent = li.classList.contains('zbalene') ? `▸ ${n}` : '▾'; b.title = li.classList.contains('zbalene') ? `Rozbaliť (${n} osôb)` : 'Zbaliť vetvu'; };
      popis();
      b.addEventListener('mousedown', (e) => e.stopPropagation());
      b.addEventListener('click', () => { li.classList.toggle('zbalene'); popis(); });
      couple.insertAdjacentElement('afterend', b);
      vetvy.push(li);
      (li as any)._popis = popis;
    }
    if (vetvy.length) {
      const nastavVsetko = (zbal: boolean) => vetvy.forEach((li, i) => { if (i === 0) return; li.classList.toggle('zbalene', zbal); (li as any)._popis(); });
      ovl.insertAdjacentHTML('beforeend', '<button data-v="zbal">Zbaliť vetvy</button><button data-v="rozbal">Rozbaliť všetko</button>');
      ovl.querySelector('[data-v=zbal]')!.addEventListener('click', () => nastavVsetko(true));
      ovl.querySelector('[data-v=rozbal]')!.addEventListener('click', () => nastavVsetko(false));
    }
    // posúvanie ťahaním myšou
    let tah = false, x0 = 0, y0 = 0, sl = 0, st = 0;
    wrap.addEventListener('mousedown', (e) => {
      tah = true; x0 = e.clientX; y0 = e.clientY; sl = wrap.scrollLeft; st = wrap.scrollTop;
      wrap.classList.add('tahanie'); e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => {
      if (!tah) return;
      wrap.scrollLeft = sl - (e.clientX - x0);
      wrap.scrollTop = st - (e.clientY - y0);
    });
    window.addEventListener('mouseup', () => { tah = false; wrap.classList.remove('tahanie'); });
    // na začiatku vycentrovať (koreň stromu je v strede)
    wrap.scrollLeft = (wrap.scrollWidth - wrap.clientWidth) / 2;
  }
</script>
